# Copy to .env and fill in. Never commit .env.

# RustFS image tag (https://hub.docker.com/r/rustfs/rustfs/tags)
RUSTFS_IMAGE_TAG=1.0.0

# Root credentials. Generate with e.g.:
#   openssl rand -hex 12        (access key)
#   openssl rand -base64 30     (secret key)
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me

# Host directories (on the persistent volume); must be owned by uid 10001.
# On SURF Research Cloud: /data/<storage-volume-name>/rustfs
RUSTFS_DATA_DIR=/data/storage/rustfs/data
RUSTFS_LOGS_DIR=/data/storage/rustfs/logs

# Host interface/ports to publish on.
RUSTFS_BIND_IP=127.0.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
